{
  "name": "@crombolo/simple-redirects",
  "version": "0.60.0",
  "description": "Manage redirects in the Crombolo backoffice: a Settings screen over the redirect engine in core.",
  "license": "MIT",
  "author": "Crombolo",
  "homepage": "https://github.com/kineco-au/crombolo-cms#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kineco-au/crombolo-cms.git",
    "directory": "packages/simple-redirects"
  },
  "bugs": {
    "url": "https://github.com/kineco-au/crombolo-cms/issues"
  },
  "keywords": [
    "crombolo",
    "crombolo-extension",
    "crombolo-bundle",
    "redirects",
    "url-rewriting",
    "cms"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "type": "module",
  "exports": {
    ".": "./src/server/index.ts"
  },
  "files": [
    "NOTICE",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "crombolo": {
    "bundleType": "extension",
    "id": "redirects",
    "name": "Redirects",
    "server": "redirects",
    "schemaVersion": 5,
    "settings": {
      "section": {
        "label": "Where redirects are managed",
        "type": "choice",
        "values": [
          "settings",
          "content"
        ],
        "default": "settings"
      }
    },
    "permissions": {
      "backoffice.code": "Shows the redirects screen in Settings",
      "redirects.read": "Lists the redirect rules on the Redirects screen",
      "redirects.write": "Saves the rules you add, change and remove there",
      "content.read": "Shows the address of the page each rule sends people to"
    },
    "extensions": [
      {
        "type": "menuItem",
        "alias": "Crombolo.MenuItem.Redirects",
        "name": "Redirects Menu Item",
        "weight": 250,
        "meta": {
          "label": "Redirects",
          "description": "Rules you add by hand, sending an address on to a page or another site.",
          "icon": "icon-arrow-right",
          "entityType": "crombolo-redirects",
          "menus": [
            "Umb.Menu.AdvancedSettings"
          ]
        }
      },
      {
        "type": "workspace",
        "alias": "Crombolo.Workspace.Redirects",
        "name": "Redirects Workspace",
        "element": "src/backoffice/redirects-workspace.js",
        "meta": {
          "entityType": "crombolo-redirects"
        }
      }
    ]
  },
  "peerDependencies": {
    "@crombolo/crombolo": ">=0.60.0"
  },
  "dependencies": {
    "@crombolo/extension": "workspace:*"
  }
}
