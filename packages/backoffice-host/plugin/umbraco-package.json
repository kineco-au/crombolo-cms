{
  "$schema": "../../backoffice-dist/dist/umbraco-package-schema.json",
  "name": "Crombolo",
  "id": "Crombolo.Core",
  "version": "0.63.0",
  "allowPublicAccess": false,
  "extensions": [
    {
      "type": "theme",
      "alias": "Crombolo.Theme.Dark",
      "name": "Dark",
      "css": "/crombolo-plugin/branding/theme-dark.css",
      "weight": 200,
      "overwrites": "umb-dark-theme"
    },
    {
      "type": "theme",
      "alias": "Crombolo.Theme.System",
      "name": "Match my system",
      "css": "/crombolo-plugin/branding/theme-system.css",
      "weight": 250
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Crombolo.EntryPoint.SessionGuard",
      "name": "Crombolo Session Guard",
      "js": "/crombolo-plugin/session-guard.js"
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Crombolo.EntryPoint.ThemeSync",
      "name": "Crombolo Theme Sync",
      "js": "/crombolo-plugin/theme-sync.js"
    },
    {
      "type": "entityUserPermission",
      "alias": "Crombolo.UserPermission.Remote.Pull",
      "name": "Crombolo Remote Pull Permission",
      "forEntityTypes": ["crombolo-remote"],
      "meta": {
        "verbs": ["Crombolo.Remote.Pull"],
        "label": "Pull a copy",
        "description": "Download a copy of this site to work on, with members and users anonymised"
      }
    },
    {
      "type": "entityUserPermission",
      "alias": "Crombolo.UserPermission.Remote.PullFull",
      "name": "Crombolo Remote PullFull Permission",
      "forEntityTypes": ["crombolo-remote"],
      "meta": {
        "verbs": ["Crombolo.Remote.PullFull"],
        "label": "Pull a full copy",
        "description": "Download a copy that includes members and users, sealed with a passphrase"
      }
    },
    {
      "type": "entityUserPermission",
      "alias": "Crombolo.UserPermission.Remote.Push",
      "name": "Crombolo Remote Push Permission",
      "forEntityTypes": ["crombolo-remote"],
      "meta": {
        "verbs": ["Crombolo.Remote.Push"],
        "label": "Push",
        "description": "Replace this site with a copy sent from a terminal"
      }
    },
    {
      "type": "entityUserPermission",
      "alias": "Crombolo.UserPermission.Remote.PushProtected",
      "name": "Crombolo Remote PushProtected Permission",
      "forEntityTypes": ["crombolo-remote"],
      "meta": {
        "verbs": ["Crombolo.Remote.PushProtected"],
        "label": "Push to a protected site",
        "description": "Replace a site people rely on, and approve or decline other people's pushes to it"
      }
    },
    {
      "type": "entityUserPermission",
      "alias": "Crombolo.UserPermission.Remote.ApplyStructure",
      "name": "Crombolo Remote ApplyStructure Permission",
      "forEntityTypes": ["crombolo-remote"],
      "meta": {
        "verbs": ["Crombolo.Remote.ApplyStructure"],
        "label": "Change a site's structure",
        "description": "Apply a bundle that changes the site's content types, stylesheets or scripts. Pushing a whole site, or changing templates or code, also needs Install code on this site"
      }
    },
    {
      "type": "entityUserPermission",
      "alias": "Crombolo.UserPermission.Remote.InstallCode",
      "name": "Crombolo Remote InstallCode Permission",
      "forEntityTypes": ["crombolo-remote"],
      "meta": {
        "verbs": ["Crombolo.Remote.InstallCode"],
        "label": "Install code on this site",
        "description": "Install bundles, the code a bundle carries and the templates it adds or changes, and push a whole site: all of these run on the server. Administrators only have this when a group gives it to them: give it to a group of its own rather than Administrators"
      }
    },
    {
      "type": "entityUserPermission",
      "alias": "Crombolo.UserPermission.Media.Read",
      "name": "Crombolo Media Read Permission",
      "forEntityTypes": ["media"],
      "meta": {
        "verbs": ["Crombolo.Media.Read"],
        "label": "Browse",
        "description": "Open media items and folders in the Media section"
      }
    },
    {
      "type": "entityUserPermission",
      "alias": "Crombolo.UserPermission.Media.Update",
      "name": "Crombolo Media Update Permission",
      "forEntityTypes": ["media"],
      "meta": {
        "verbs": ["Crombolo.Media.Update"],
        "label": "Change",
        "description": "Upload, edit, move, sort and delete media, and empty or restore from the recycle bin"
      }
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Crombolo.EntryPoint.MediaPermissions",
