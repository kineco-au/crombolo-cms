{
  "name": "@crombolo/entra",
  "version": "0.65.0",
  "description": "Edit a Microsoft Entra sign-in from the Crombolo backoffice: tenant, app credentials and group mappings, over the provider the site declares in code.",
  "license": "MIT",
  "author": "Crombolo",
  "homepage": "https://github.com/kineco-au/crombolo-cms#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kineco-au/crombolo-cms.git",
    "directory": "packages/entra"
  },
  "bugs": {
    "url": "https://github.com/kineco-au/crombolo-cms/issues"
  },
  "keywords": [
    "crombolo",
    "crombolo-extension",
    "crombolo-bundle",
    "entra",
    "azure-ad",
    "single-sign-on",
    "cms"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "type": "module",
  "exports": {
    ".": "./src/server/index.ts"
  },
  "files": [
    "NOTICE",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "crombolo": {
    "bundleType": "extension",
    "id": "entra",
    "name": "Microsoft Entra",
    "server": "entraSettings",
    "schemaVersion": 6,
    "settings": {
      "section": {
        "label": "Where the Entra settings are",
        "type": "choice",
        "values": [
          "settings",
          "content"
        ],
        "default": "settings"
      }
    },
    "permissions": {
      "identityProviders.read": "Shows the Microsoft Entra sign-in settings on its screen",
      "identityProviders.write": "Saves the Entra settings an administrator changes there"
    },
    "extensions": [
      {
        "type": "menuItem",
        "alias": "Crombolo.MenuItem.Entra",
        "name": "Microsoft Entra Menu Item",
        "weight": 240,
        "meta": {
          "label": "Microsoft Entra",
          "icon": "icon-key",
          "entityType": "crombolo-entra",
          "menus": [
            "Umb.Menu.AdvancedSettings"
          ]
        }
      },
      {
        "type": "workspace",
        "alias": "Crombolo.Workspace.Entra",
        "name": "Microsoft Entra Workspace",
        "meta": {
          "entityType": "crombolo-entra"
        },
        "screen": "sign-in"
      }
    ]
  },
  "peerDependencies": {
    "@crombolo/crombolo": ">=0.65.0"
  },
  "dependencies": {
    "@crombolo/extension": "workspace:*"
  }
}
