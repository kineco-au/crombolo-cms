# Debian rather than Alpine: extensions run under Deno (story 311), which
# publishes glibc builds only.
FROM oven/bun:1-slim

# The repository is bind-mounted at /app instead of copied, so this image only
# carries the runtime and the entrypoint; editing a file on the host is enough.
WORKDIR /app

# `crombolo bundle deploy` sends only what git says is committed, so it needs git.
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*

COPY cms-entrypoint.sh /usr/local/bin/cms-entrypoint
RUN chmod +x /usr/local/bin/cms-entrypoint

EXPOSE 8080

ENTRYPOINT ["cms-entrypoint"]
CMD ["bun", "--watch", "server.ts"]
